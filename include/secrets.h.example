#pragma once

// ============================================================
//  OPCIONAL - SOLO PARA DESARROLLO
// ============================================================
//
// El dispositivo YA NO NECESITA este archivo. WiFi y API keys se cargan desde
// el navegador (portal cautivo en el primer arranque, o desk-radar.local/config
// despues) y se guardan en NVS. Ver "Configuracion inicial" en el README.
//
// Este archivo existe solo como comodidad: si lo copias como "secrets.h" y le
// pones tus datos, se precargan en NVS UNA SOLA VEZ en el primer arranque, para
// no tener que pasar por el portal cada vez que reflasheas durante el
// desarrollo. Despues de esa primera vez se ignora (hay una marca "seeded" en
// NVS), asi que el boton "Reiniciar config WiFi" funciona igual.
//
// secrets.h esta en .gitignore: nunca se sube al repo.

#define WIFI_SSID     "TU_WIFI"
#define WIFI_PASSWORD "TU_PASSWORD"

// Credenciales OAuth2 de tu cuenta OpenSky (API client)
// Se generan en: https://opensky-network.org/my-opensky -> API Client
#define OPENSKY_CLIENT_ID     "TU_CLIENT_ID"
#define OPENSKY_CLIENT_SECRET "PONE_ACA_TU_CLIENT_SECRET"

// API key de GNews.io para la pantalla NOTICIAS.
// Registro gratis y sin tarjeta de credito en https://gnews.io/register
#define GNEWS_API_KEY "PONE_ACA_TU_GNEWS_API_KEY"

// La pantalla CLIMA usa Open-Meteo, que NO necesita API key ni registro.
